<Window x:Class="cmdNet.PassRar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:cmdNet"
        Title="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_Title}"
        Height="500" Width="700"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">

    <!-- ========== Viewbox برای مقیاس‌گذاری کل محتوا ========== -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Margin="10" 
              
              Background="White">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================= -->
            <!-- 1. انتخاب فایل RAR -->
            <!-- ============================================= -->
            <GroupBox Header="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_GroupSelectRar}"
                      Grid.Row="0" Margin="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtRarFile" 
                             Grid.Column="0"
                             Margin="0,0,5,0" 
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             Height="24"/>
                    <Button x:Name="btnSelectRar" 
                            Grid.Column="1"
                            Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_BtnOpen}"
                            Click="BtnSelectRar_Click" 
                            Style="{StaticResource ModernButtonStyle}"
                           
                            />
                </Grid>
            </GroupBox>

            <!-- ============================================= -->
            <!-- 2. انتخاب فایل کلمات پایه -->
            <!-- ============================================= -->
            <GroupBox Header="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_GroupSelectWords}"
                      Grid.Row="1" Margin="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtWordsFile" 
                             Grid.Column="0"
                             Margin="0,0,5,0" 
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             Height="24"/>
                    <Button x:Name="btnSelectWords" 
                            Grid.Column="1"
                            Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_BtnOpen}"
                            Click="BtnSelectWords_Click" 
                            Style="{StaticResource ModernButtonStyle}"
                           />
                </Grid>
            </GroupBox>

            <!-- ============================================= -->
            <!-- 3. کلمات بارگذاری شده -->
            <!-- ============================================= -->
            <GroupBox Header="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_GroupLoadedWords}"
                      Grid.Row="2" Margin="0,5">
                <ListBox x:Name="lstWords" Height="60" Margin="5"/>
            </GroupBox>

            <!-- ============================================= -->
            <!-- 4. تنظیمات تولید ترکیبات -->
            <!-- ============================================= -->
            <GroupBox Header="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_GroupSettings}"
                      Grid.Row="3" Margin="0,5">
                <StackPanel Margin="5">
                    <CheckBox x:Name="chkSingleWords" 
                              Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_ChkSingleWords}"
                              IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="chkDoubleCombinations" 
                              Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_ChkDoubleComb}"
                              IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="chkDoubleCombinationsReverse" 
                              Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_ChkDoubleCombReverse}"
                              IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="chkIncludeSelfCombination" 
                              Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_ChkSelfComb}"
                              IsChecked="False" Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <!-- ============================================= -->
            <!-- دکمه شروع و وضعیت -->
            <!-- ============================================= -->
            <Grid Grid.Row="4" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="progressBar" Height="22" Grid.Column="0" Margin="0,0,10,0"/>
                <Button x:Name="btnStart" 
                        Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_BtnStart}"
                        Click="BtnStart_Click" 
                      
                        Grid.Column="1" 
                       
                        Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="btnStop" 
                        Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_BtnStop}"
                        Click="BtnStop_Click" 
                        Style="{StaticResource ModernButtonStyle}" 
                        Grid.Column="2" 
                        IsEnabled="False"
                       />
            </Grid>

            <!-- ============================================= -->
            <!-- 5. نتیجه تست -->
            <!-- ============================================= -->
            <GroupBox Header="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_GroupResult}"
                      Grid.Row="5" Margin="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblStatus" Grid.Row="0" Margin="5" FontWeight="Bold"/>
                    <ListBox x:Name="lstResults" Grid.Row="1" MinHeight="30" Width="600"   FontFamily="Consolas"/>
                    <Button x:Name="btnSaveResult" Grid.Column="1"
         Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=PassRar_BtnSave}"
         Click="BtnSaveResult_Click" 
         Grid.Row="1" 
      
         HorizontalAlignment="Left" 
       
         Style="{StaticResource ModernButtonStyle}"  VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>

            <!-- ============================================= -->
            <!-- دکمه ذخیره نتیجه -->
            <!-- ============================================= -->
           
        </Grid>
    </Viewbox>
</Window>